<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="1200" viewBox="0 0 1600 1200" role="img" aria-label="BOWLER The Venice Harbour Raid, March 1945">
  <defs>
    <linearGradient id="sky" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#7e9eac"/>
      <stop offset="36%" stop-color="#d4d8d4"/>
      <stop offset="76%" stop-color="#a3b6bf"/>
      <stop offset="100%" stop-color="#d7d4d0"/>
    </linearGradient>
    <linearGradient id="water" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#8eb4b7"/>
      <stop offset="100%" stop-color="#3d7685"/>
    </linearGradient>
    <radialGradient id="smoke" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#303536" stop-opacity="0.96"/>
      <stop offset="24%" stop-color="#5a5f5e" stop-opacity="0.78"/>
      <stop offset="65%" stop-color="#8a8e8b" stop-opacity="0.42"/>
      <stop offset="100%" stop-color="#8a8e8b" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="flame" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffd76d"/>
      <stop offset="25%" stop-color="#ffb12d"/>
      <stop offset="55%" stop-color="#ef5a11"/>
      <stop offset="100%" stop-color="#4c1208"/>
    </radialGradient>
    <filter id="shadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="18" stdDeviation="14" flood-color="#000" flood-opacity="0.33"/>
    </filter>
  </defs>

  <rect width="1600" height="1200" fill="url(#sky)"/>

